# === WhatsApp Cloud API (Meta) ===
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
WHATSAPP_PHONE_NUMBER_ID=id_del_numero_de_telefono
WHATSAPP_VERIFY_TOKEN=un_texto_secreto_que_tu_inventas

# === Claude API (extracción y corrección) ===
ANTHROPIC_API_KEY=sk-ant-...
LLM_ENABLED=false   # false = validación gratuita sin IA; true = corrección activada

# === Reglas de horario (opción 3: corte con tolerancia) ===
TIMEZONE=America/Bogota
REPORT_CUTOFF=18:30        # Hora oficial de cierre
REPORT_GRACE_MINUTES=30    # Tolerancia: se acepta pero queda marcado TARDÍO

# === Base de datos (vacío = SQLite local) ===
DATABASE_URL=
